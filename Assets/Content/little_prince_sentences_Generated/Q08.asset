  m_Name: Q08
  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  instruction: Listen and choose the meaning.
  audioClip: {fileID: 0}
  spokenText: "Togda narysoval jesm otvorjenu zmiju boa, da by dorastli mogli razum\u011Bti."
  options:
  - Then I drew a hat, so that the grown-ups could be happy.
  - Then I read the book to the grown-ups.
  - Then I drew the boa constrictor opened up, so that the grown-ups could understand.
  - Then I showed the grown-ups my first drawing again.
  correctIndex: 2
  explanation: "razum\u011Bti = to understand."
