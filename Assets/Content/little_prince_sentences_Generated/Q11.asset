  m_Script: {fileID: 11500000, guid: 760e66267ad27494bb73e0258e248bdb, type: 3}
  m_Name: Q11
  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  instruction: Listen and choose the meaning.
  audioClip: {fileID: 0}
  spokenText: "Potom ne mo\u017Ee dvigati se i spi \u0161est m\u011Bsecev, dokol\u011B
    ju ne pr\u011Bvari."
  options:
  - After that it moves quickly and eats for six months.
  - After that it sleeps for six years.
  - After that it cannot move and sleeps for six months, until it has digested it.
  - After that it can swallow an elephant.
  correctIndex: 2
  explanation: "m\u011Bsecev = months. spi = sleeps."
