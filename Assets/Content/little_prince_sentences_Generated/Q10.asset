  m_Script: {fileID: 11500000, guid: 760e66267ad27494bb73e0258e248bdb, type: 3}
  m_Name: Q10
  m_EditorClassIdentifier: Assembly-CSharp::QuestionData
  instruction: Listen and choose the meaning.
  audioClip: {fileID: 0}
  spokenText: "Kogda mi bylo \u0161est l\u011Bt, uvid\u011Bl jesm raz pr\u011Bl\u011Bpy
    obrazok v knig\u011B o pral\u011Bsu."
  options:
  - When I was six, I wrote a book about the jungle.
  - When I was six, I once saw a magnificent picture in a book about the primeval
    forest.
  - I was six months old when I saw a picture of a hat.
  - When I was six, the grown-ups showed me a picture of a boa constrictor.
  correctIndex: 1
  explanation: "l\u011Bt = years. pral\u011Bs = primeval forest."
